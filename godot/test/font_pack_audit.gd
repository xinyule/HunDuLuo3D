extends SceneTree

## 1.2.0 字体修复·导出产物等效验证：把网页导出的 index.pck 当资源包挂载，
## 在「包内资源」上复跑字体审计——包内字体自含全语料 ⇔ 网页运行时（无系统字体）不乱码。
## 前置：先导出 Web 到 /tmp/webfont/index.html（同目录 index.pck）。
## 运行：godot --headless --path . --script res://test/font_pack_audit.gd

var _fails := 0

func _check(cond: bool, label: String) -> void:
	print(("  OK   " if cond else "  FAIL ") + label)
	if not cond:
		_fails += 1

func _initialize() -> void:
	var ok := ProjectSettings.load_resource_pack("/tmp/webfont/index.pck")
	_check(ok, "网页导出 pck 可挂载")
	if not ok:
		print("FONT PACK AUDIT FAIL")
		quit(1)
		return
	_check(not ResourceLoader.exists("res://assets/font/noto_sc.otf"), "包内已无旧子集字体")
	_check(ResourceLoader.exists("res://assets/font/noto_sc_full.otf"), "包内含完整字体资源")
	var font := load("res://assets/font/noto_sc_full.otf") as FontFile
	_check(font != null, "包内完整字体可加载")
	if font == null:
		print("FONT PACK AUDIT FAIL")
		quit(1)
		return
