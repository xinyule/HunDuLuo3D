	var corpus := {}
	for i in CORPUS.length():
		corpus[CORPUS.unicode_at(i)] = true
	var missing := 0
	for cp in corpus.keys():
		if not font.has_char(int(cp)):
			missing += 1
	_check(missing == 0, "包内字体覆盖源码语料 %d 码位（缺 %d）" % [corpus.size(), missing])
	print("FONT PACK AUDIT ", "PASS" if _fails == 0 else "FAIL x%d" % _fails)
	quit(0 if _fails == 0 else 1)
